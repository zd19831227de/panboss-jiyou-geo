# GEO运营系统 配置示例
# 用法：复制本文件为 backend/.env，按需修改（.env 不会被 git 提交）

# ---------------------------------------------------------------------------
# 端口配置（改完需要重启服务：start_services.py stop / start）
# ---------------------------------------------------------------------------

# 后端 API 端口（默认 18770）
GEO_BACKEND_PORT=18770

# 前端页面端口（默认 15173）
GEO_FRONTEND_PORT=15173

# AI 监测浏览器端口：豆包 / 千问 / 元宝
GEO_PLATFORM_PORTS=doubao:9321,qianwen:9322,yuanbao:9323

# 发布平台浏览器端口（8 个平台）。
# 如果这些端口被其它程序占用（例如同一台机器上的另一个项目），
# 直接改成别的端口号即可，例如 9621-9628。
# 注意：不要用 9221-9229 / 9421-9429，也不要和上面的 AI 监测端口重复。
GEO_PUBLISH_PORTS=website:9521,ctrip_travel:9522,baijiahao:9523,sohu:9524,zhihu:9525,xiaohongshu:9526,douyin:9527,toutiao:9528

# ---------------------------------------------------------------------------
# 大模型 API Key（也可以在前端「系统设置 → 大模型设置」里填）
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_MODEL=qwen-plus

# ---------------------------------------------------------------------------
# 验证码自动解决（可选）
# ---------------------------------------------------------------------------
CAPSOLVER_API_KEY=

# ---------------------------------------------------------------------------
# 监测自动补内容（监测完成后，未引用关键词自动生成内容草稿）
# 说明：这些键已在 app/core/config.py Settings 中声明，可安全写入 .env
# ---------------------------------------------------------------------------
# GEO_AUTO_CONTENT=1                     # 总开关，0 关闭
# GEO_AUTO_CONTENT_TRIGGER=all           # any=任一平台未引用即生成 / all=全部平台未引用
# GEO_AUTO_CONTENT_TYPE=media            # 内容体裁（media/faq 等）
# GEO_AUTO_CONTENT_PLATFORM=website      # 草稿发布渠道：website/zhihu/baijiahao 等
# GEO_AUTO_CONTENT_MAX_PER_KEYWORD=3     # 同一关键词最多自动生成几篇
# GEO_AUTO_CONTENT_REGEN_COOLDOWN_HOURS=24  # 重推冷却小时数

# ---------------------------------------------------------------------------
# 安全：JWT 密钥。留空会自动生成随机密钥并写入 backend/.secret_key
# ---------------------------------------------------------------------------
SECRET_KEY=

# ---------------------------------------------------------------------------
# 其它（一般不用改）
# ---------------------------------------------------------------------------
# GEO_HOME=            # 自定义运行时目录（日志/截图/证据）
# GEO_BROWSER_HOME=    # 自定义浏览器 profile 目录
# CORS_ORIGINS=*       # 默认只允许本机前端/后端端口；也可写成逗号分隔白名单
