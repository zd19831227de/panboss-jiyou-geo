# GEO 知识库运行时资源（系统会把真实客户品牌事实/证据源写入这些文件）。
# 保留 manifest.json 作为模板；缺失的资源文件由
# backend/app/services/geo_knowledge_base.py:ensure_knowledge_files() 自动创建。
geo/knowledge_base/*.json
!geo/knowledge_base/manifest.json
geo/knowledge_base/*.tmp
geo/knowledge_base/.*.lock
